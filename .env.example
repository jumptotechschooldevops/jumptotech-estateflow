# Copy this file to .env and adjust values as needed:
#   cp .env.example .env
# Never commit the real .env file — it is already excluded via .gitignore.

# --- PostgreSQL ---
POSTGRES_USER=estateflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=estateflow
# Host port Postgres is published on. Change if 5432 is already in use on your machine.
POSTGRES_PORT=5432

# --- Redis ---
# Host port Redis is published on. Change if 6379 is already in use on your machine.
REDIS_PORT=6379

# --- Backend (Express API) ---
# Host port the backend API is published on. Change if 5000 is already in use on your machine
# (on macOS, AirPlay Receiver commonly occupies port 5000 — disable it or change this value).
BACKEND_PORT=5000

# --- Frontend (Nginx) ---
# Host port the frontend is published on. Change if 8080 is already in use on your machine.
FRONTEND_PORT=8080

# --- Admin auth (required to create/update/delete properties and images) ---
# Lab-grade shared secret — swap for a real auth system before using this outside a course lab.
ADMIN_API_TOKEN=dev-local-admin-token

# --- Amazon S3 (property images) ---
# Region the S3 bucket lives in.
AWS_REGION=us-east-1
# Name of the private S3 bucket created per docs/09-s3-image-integration.md. Leave blank to run
# the app locally without image upload support.
S3_BUCKET_NAME=
# Never put long-lived AWS access keys here. These are optional passthroughs for local testing
# only, picked up from your own `aws configure`/SSO session if you export them in your shell
# before `docker compose up` — leave unset to skip local image-upload testing entirely. In EKS,
# the backend uses IRSA instead (see docs/10-iam-oidc-irsa.md) and these are never set.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
